{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role, Pi details, and language preference",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique user ID" },
        "email": { "type": "string", "description": "Email address" },
        "displayName": { "type": "string", "description": "Full display name" },
        "role": { "type": "string", "enum": ["admin", "seller", "customer"] },
        "piUsername": { "type": "string", "description": "Pi Network username" },
        "piWalletAddress": { "type": "string", "description": "Pi wallet public key" },
        "language": { "type": "string", "enum": ["en", "ha"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Marketplace item listed for sale in Pi or USD",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "title": { "type": "string", "maxLength": 120 },
        "titleHa": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 1000 },
        "descriptionHa": { "type": "string", "maxLength": 1000 },
        "pricePi": { "type": "number" },
        "priceUsd": { "type": "number" },
        "category": { "type": "string" },
        "stock": { "type": "number" },
        "imageUrl": { "type": "string" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["productId", "sellerId", "title", "pricePi", "category"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase transaction details",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "sellerId": { "type": "string" },
        "items": { "type": "array" },
        "totalPi": { "type": "number" },
        "totalUsd": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] },
        "paymentMethod": { "type": "string" },
        "piPaymentId": { "type": "string" },
        "shippingAddress": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["orderId", "customerId", "items", "totalPi", "status"]
    },
    "Store": {
      "title": "Store",
      "description": "Seller store profile",
      "type": "object",
      "properties": {
        "storeId": { "type": "string" },
        "sellerId": { "type": "string" },
        "storeName": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "createdAt": { "type": "string" }
      },
      "required": ["storeId", "sellerId", "storeName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products catalog"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Orders collection"
    },
    "/stores/{storeId}": {
      "schema": { "$ref": "#/entities/Store" },
      "description": "Seller store registrations"
    }
  }
}
